#!/usr/bin/env node

import { GoogleSpreadsheet } from 'google-spreadsheet';
import { JWT } from 'google-auth-library';

import { createRequire } from "module";
const require = createRequire(import.meta.url);
const creds = require("./credentials.json");

const save = async (counts) => {
  // Initialize auth - see https://theoephraim.github.io/node-google-spreadsheet/#/guides/authen>
  const serviceAccountAuth = new JWT({
    // env var values here are copied from service account credentials generated by google
    // see "Authentication" section in docs for more info
    email: creds.client_email,
    key: creds.private_key,
    scopes: [
      'https://www.googleapis.com/auth/spreadsheets',
    ],
  });

  const doc = new GoogleSpreadsheet('INSERT_SHEET_ID_HERE',
    serviceAccountAuth);

  await doc.loadInfo(); // loads document properties and worksheets
  console.log(doc.title);
  process.exit();

  const sheet = doc.sheetsByIndex[0];

  await sheet.loadCells('A1:PS9');
  let i;
  for (i = 1; i < 50000; i++) {
    if (sheet.getCell(0, i).value == null)
      break;
  }
  sheet.getCell(0, i).value = sheet.getCell(0, i - 1).value + 1;
  for (let j = 0; j < 5; j++)
    sheet.getCell(1 + j, i).value = counts[j];
  const curCol = sheet.getCell(0, i).a1Column;
  sheet.getCell(6, i).formula = `=sum(${curCol}2:${curCol}6)`;
  const prevCol = sheet.getCell(0, i - 1).a1Column;
  sheet.getCell(7, i).formula = `=${curCol}7-${prevCol}7`;
  const backCol = sheet.getCell(0, i - 6).a1Column;
  sheet.getCell(8, i).formula = `=average(${backCol}8:${curCol}8)`;
  await sheet.saveUpdatedCells();
}

save();
//export default save;
